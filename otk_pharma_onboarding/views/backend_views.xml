<?xml version="1.0" encoding="utf-8"?>
<!-- otk_pharma_onboarding/views/backend_views.xml -->
<odoo>

    <!-- ── List View ─────────────────────────────────────────── -->
    <record id="view_otk_pharma_onboarding_application_list" model="ir.ui.view">
        <field name="name">otk.pharma.onboarding.application.list</field>
        <field name="model">otk.pharma.onboarding.application</field>
        <field name="arch" type="xml">
            <list string="Onboarding Applications" decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  decoration-warning="state == 'submitted'">
                <field name="name"/>
                <field name="contact_name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="pharmacy_license_number"/>
                <field name="contract_signed"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-warning="state == 'submitted'"
                       decoration-info="state == 'draft'"/>
                <field name="create_date" string="Applied On"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ─────────────────────────────────────────── -->
    <record id="view_otk_pharma_onboarding_application_form" model="ir.ui.view">
        <field name="name">otk.pharma.onboarding.application.form</field>
        <field name="model">otk.pharma.onboarding.application</field>
        <field name="arch" type="xml">
            <form string="Onboarding Application">

                <!-- Status Bar -->
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,rejected"/>
                    <button name="action_approve"
                            string="Activate Account"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'submitted'"/>
                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"
                            invisible="state not in ('draft', 'submitted')"/>
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'rejected'"/>
                </header>

                <sheet>
                    <!-- Alerts -->
                    <div class="alert alert-success" role="alert"
                         invisible="state != 'approved'">
                        <strong>Account Active.</strong>
                        Partner record created:
                        <field name="partner_id" readonly="1"/>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'rejected'">
                        <strong>Application Rejected.</strong>
                        Rejection reason sent by email.
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Pharmacy Name"/>
                        </h1>
                    </div>

                    <group>
                        <!-- Left Column: Contact Info -->
                        <group string="Contact Information">
                            <field name="contact_name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="pharmacy_license_number"/>
                        </group>

                        <!-- Right Column: Address -->
                        <group string="Address">
                            <field name="street"/>
                            <field name="city"/>
                            <field name="province"/>
                            <field name="postal_code"/>
                        </group>
                    </group>

                    <group>
                        <!-- Left Column: Documents -->
                        <group string="Documents">
                            <field name="pharmacy_license_doc"
                                   filename="pharmacy_license_doc_filename"
                                   widget="binary"/>
                            <field name="pharmacy_license_doc_filename" invisible="1"/>
                            <field name="contract_signed"/>
                            <field name="contract_signed_date"
                                   invisible="not contract_signed"/>
                            <field name="contract_signature"
                                   widget="image"
                                   invisible="not contract_signed"
                                   string="Captured Signature"
                                   readonly="1"
                                   options="{'size': [300, 100]}"/>
                            <field name="contract_pdf"
                                   filename="contract_pdf_filename"
                                   widget="binary"
                                   invisible="not contract_signed"
                                   string="Signed Contract PDF"/>
                            <field name="contract_pdf_filename" invisible="1"/>
                        </group>

                        <!-- Right Column: Commercial Settings -->
                        <group string="Commercial Settings (set on activation)">
                            <field name="pricelist_id"
                                   options="{'no_create': True}"/>
                            <field name="delivery_fee"
                                   widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <!-- Rejection Reason (visible only when rejected) -->
                    <group string="Rejection Details" invisible="state != 'rejected'">
                        <field name="rejection_reason" readonly="1"/>
                    </group>

                </sheet>

                <!-- Chatter -->
                <chatter/>

            </form>
        </field>
    </record>

    <!-- ── Search View ────────────────────────────────────────── -->
    <record id="view_otk_pharma_onboarding_application_search" model="ir.ui.view">
        <field name="name">otk.pharma.onboarding.application.search</field>
        <field name="model">otk.pharma.onboarding.application</field>
        <field name="arch" type="xml">
            <search string="Search Applications">
                <field name="name"/>
                <field name="email"/>
                <field name="pharmacy_license_number"/>
                <filter string="Pending Review" name="submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter string="Active" name="approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Province" name="group_province"
                            context="{'group_by': 'province'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Reject Wizard Form ─────────────────────────────────── -->
    <record id="view_otk_pharma_onboarding_reject_wizard_form" model="ir.ui.view">
        <field name="name">otk.pharma.onboarding.reject.wizard.form</field>
        <field name="model">otk.pharma.onboarding.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Application">
                <sheet>
                    <group>
                        <field name="application_id" readonly="1"/>
                        <field name="rejection_reason"
                               placeholder="Enter the reason for rejection. This will be included in the email sent to the applicant."
                               widget="text"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_reject"
                            string="Reject &amp; Send Email"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────────────── -->
    <record id="action_otk_pharma_onboarding_application" model="ir.actions.act_window">
        <field name="name">Onboarding Applications</field>
        <field name="res_model">otk.pharma.onboarding.application</field>
        <field name="view_mode">list,form</field>
        <field name="path">pharmacy-onboarding</field>
        <field name="search_view_id" ref="view_otk_pharma_onboarding_application_search"/>
        <field name="context">{'search_default_submitted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No onboarding applications yet
            </p>
            <p>
                Partner pharmacies submit applications via the B2B registration portal.
            </p>
        </field>
    </record>

    <!-- ── Menu ───────────────────────────────────────────────── -->
    <menuitem id="menu_otk_pharma_root"
              name="Pharmacy B2B"
              sequence="70"
              web_icon="otk_pharma_onboarding,static/description/icon.png"/>

    <menuitem id="menu_otk_pharma_onboarding"
              name="Onboarding"
              parent="menu_otk_pharma_root"
              sequence="10"/>

    <menuitem id="menu_otk_pharma_onboarding_applications"
              name="Applications"
              parent="menu_otk_pharma_onboarding"
              action="action_otk_pharma_onboarding_application"
              sequence="10"/>

    <!-- ── Partner Form Extension ────────────────────────────── -->
    <record id="view_res_partner_otk_pharma_form" model="ir.ui.view">
        <field name="name">res.partner.otk.pharma.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Inject our tab after the "Sales & Purchase" tab -->
            <xpath expr="//notebook" position="inside">
                <page string="B2B Pharmacy" name="otk_pharma_b2b">

                    <group>
                        <group string="Account Status">
                            <field name="x_onboarding_state"
                                   widget="badge"
                                   decoration-success="x_onboarding_state == 'active'"
                                   decoration-warning="x_onboarding_state == 'pending'"
                                   decoration-danger="x_onboarding_state == 'suspended'"/>
                            <field name="x_is_b2b_pharmacy"/>
                        </group>

                        <group string="Commercial Settings">
                            <field name="x_delivery_fee" widget="monetary"/>
                            <field name="property_product_pricelist"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>

                    <group>
                        <group string="Contract">
                            <field name="x_contract_signed"/>
                            <field name="x_contract_signed_date"
                                   invisible="not x_contract_signed"
                                   readonly="1"/>
                            <field name="x_contract_pdf"
                                   filename="x_contract_pdf_filename"
                                   widget="binary"
                                   invisible="not x_contract_signed"
                                   string="Signed Contract PDF"/>
                            <field name="x_contract_pdf_filename" invisible="1"/>
                        </group>

                        <group string="Pharmacy License">
                            <field name="x_pharmacy_license"
                                   filename="x_pharmacy_license_filename"
                                   widget="binary"
                                   string="License Document"/>
                            <field name="x_pharmacy_license_filename" invisible="1"/>
                        </group>
                    </group>

                    <group string="Onboarding">
                        <field name="x_onboarding_application_id"
                               readonly="1"/>
                    </group>

                </page>
            </xpath>

        </field>
    </record>
</odoo>